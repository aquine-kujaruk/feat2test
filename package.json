{
  "name": "feat2test",
  "version": "4.0.0",
  "description": "Turn Gherkin Features into deterministic tests for Vitest or node:test.",
  "keywords": [
    "bdd",
    "codegen",
    "cucumber",
    "gherkin",
    "markdown",
    "sdd",
    "testing",
    "vitest",
    "feat2test",
    "cli",
    "node-test",
    "test-generation"
  ],
  "license": "MIT",
  "author": {
    "name": "aquine-kujaruk",
    "url": "https://github.com/aquine-kujaruk"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aquine-kujaruk/feat2test.git"
  },
  "bugs": {
    "url": "https://github.com/aquine-kujaruk/feat2test/issues"
  },
  "homepage": "https://github.com/aquine-kujaruk/feat2test#readme",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.22.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.0.0",
      "onFail": "download"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "skills"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "feat2test": "./dist/cli.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "codegen": "pnpm build && node dist/cli.mjs",
    "prepare": "husky",
    "release": "semantic-release",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm check && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm exec publint && pnpm exec attw --pack . --profile esm-only && node scripts/smoke-package.mjs",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/smoke-package.mjs"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/types": "8.0.6",
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "9.1.7",
    "publint": "0.3.25",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
